{
  "schemaVersion": 1,
  "id": "emotecraft-recording-addon",
  "version": "${version}",
  "name": "Emotecraft Recording Addon [Fork / Port 26.3]",
  "description": "Fork / port for Minecraft Java Edition 26.3. Records Emotecraft emotes in Flashback. The Replay Mod bridge is retained, but runtime compatibility requires a Replay Mod release for 26.3.",
  "authors": [
    "PavelDobCZ23 (upstream)",
    "MrLan112 (26.3 fork/port)"
  ],
  "contact": {
    "homepage": "https://github.com/MrLan112/Emotecraft-Recording-Addon-Fork-26.3",
    "issues": "https://github.com/MrLan112/Emotecraft-Recording-Addon-Fork-26.3/issues",
    "sources": "https://github.com/IceCraft-Studio/emotecraft-recording-addon"
  },
  "license": "GPL-3.0-or-later",
  "environment": "client",
  "entrypoints": {
    "client": [
      "studio.icecraft.emotecraftrecording.EmotecraftRecordingInit"
    ]
  },
  "mixins": [
    "emotecraft-recording-addon.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": "*",
    "emotecraft": ">=3.5.0- <3.6.0-"
  },
  "recommends": {
    "flashback": ">=0.43.6"
  }
}
